{
  "name": "dsh-ppt-master",
  "version": "6.8.0-dsh.2",
  "description": "DeepSeek Harness plugin that ships the PPT Master skill (native-editable PPTX from documents or images) with a cross-platform wrapper CLI.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "skill",
    "ppt-master",
    "pptx",
    "powerpoint",
    "drawingml"
  ],
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-ppt-master": "bin/ppt-master.mjs"
  },
  "files": [
    "lib",
    "bin",
    "scripts",
    "skills",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "VENDOR.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DASHAN-0079/dsh-ppt-master.git"
  },
  "homepage": "https://github.com/DASHAN-0079/dsh-ppt-master#readme",
  "bugs": {
    "url": "https://github.com/DASHAN-0079/dsh-ppt-master/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "vendor": "node scripts/build-vendor.mjs",
    "check": "node --check lib/index.js && node --check lib/skill.js && node --check lib/host.js && node --check bin/ppt-master.mjs",
    "test": "node --test test/plugin.test.mjs",
    "doctor": "node bin/ppt-master.mjs doctor"
  }
}
